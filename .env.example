APP_NAME=SeguPYME
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos del proyecto (la que se crea con los scripts de database/sql).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=segupyme_v15
DB_USERNAME=root
DB_PASSWORD=

# Laravel guarda sesion, cache y cola en archivos o en memoria, NO en la base de datos:
# asi la base solo tiene las tablas del modelo relacional de SeguPYME.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
